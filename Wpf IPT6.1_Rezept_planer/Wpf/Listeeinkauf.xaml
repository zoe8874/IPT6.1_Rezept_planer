<Window x:Class="Wpf.Listeeinkauf"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Listeeinkauf" Height="450" Width="800"
        Background="#F3F6F8" FontFamily="Segoe UI">
    <Grid DockPanel.Dock="Top" Height="60" Background="#fff">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="197.5"/>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Recipe Planner" Foreground="White" VerticalAlignment="Center" Margin="12,0,12,0" FontSize="18" FontWeight="Bold" Grid.ColumnSpan="2"/>



        <!-- Eingabebereich -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Grid.ColumnSpan="2">

            <ComboBox x:Name="IngredientsComboBox"
                      Width="150"
                      Margin="5"/>

            <TextBox x:Name="MengeTextBox"
                 Width="100"
                 Margin="5"
                 VerticalContentAlignment="Center"
                 Text=""/>

            <ComboBox x:Name="EinheitComboBox"
                      Width="120"
                      Margin="5"/>

            <Button Content="Hinzufügen"
                Width="120"
                Margin="5"
                Click="AddButton_Click"/>
        </StackPanel>

        <!-- Liste -->
        <ListView x:Name="EinkaufListView" Grid.ColumnSpan="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Zutat"
                                Width="200"
                                DisplayMemberBinding="{Binding ZutatName}"/>

                    <GridViewColumn Header="Menge"
                                Width="100"
                                DisplayMemberBinding="{Binding Menge}"/>

                    <GridViewColumn Header="Einheit"
                                Width="120"
                                DisplayMemberBinding="{Binding EinheitName}"/>

                    <GridViewColumn Header="Aktion" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Löschen"
                                    Tag="{Binding EintragID}"
                                    Click="DeleteButton_Click"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                </GridView>
            </ListView.View>
        </ListView>
        <Grid Background="#4cBB17" Grid.ColumnSpan="3" Margin="0,-187,0,187">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Recipe Planner" Foreground="White" VerticalAlignment="Center" Margin="12,0" FontSize="18" FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

    </Grid>
</Window>
