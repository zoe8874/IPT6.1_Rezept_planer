<Window x:Class="Wpf.Rezept"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf"
        mc:Ignorable="d"
        Title="Rezept" Height="500" Width="950">

    <DockPanel>


        <Grid DockPanel.Dock="Top"
              Height="60"
              Background="#4cBB17">

            <TextBlock Text="Recipe Planner"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="12,0"
                       FontSize="18"
                       FontWeight="Bold"/>
        </Grid>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Border Grid.Column="0"
                    Background="#FFF7F7F7"
                    BorderBrush="#FFCCCCCC"
                    BorderThickness="1"
                    Margin="10"
                    CornerRadius="6">

                <Grid Margin="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Rezepte"
                               FontWeight="Bold"
                               FontSize="18"
                               Margin="0,0,0,10"/>

                    <ListBox x:Name="RezeptListBox"
                             Grid.Row="1"
                             SelectionChanged="RezeptListBox_SelectionChanged">

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border BorderBrush="#FFCCCCCC"
                                        BorderThickness="0,0,0,1"
                                        Padding="8">

                                    <StackPanel>

                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="Bold"
                                                   FontSize="15"/>

                                        <TextBlock Text="{Binding Kategorie}"
                                                   Foreground="Gray"
                                                   FontSize="12"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>


            <Border Grid.Column="1"
                    Margin="10"
                    BorderBrush="#FFCCCCCC"
                    BorderThickness="1"
                    CornerRadius="6">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="15">

                        <TextBlock x:Name="TitelTextBlock"
                                   FontSize="24"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="KategorieTextBlock"
                                   Foreground="Gray"
                                   Margin="0,2,0,15"/>


                        <Border x:Name="StatusBorder"
                                Padding="10"
                                CornerRadius="6"
                                Margin="0,0,0,15"
                                Background="#FFD4EDDA">

                            <TextBlock x:Name="StatusTextBlock"
                                       FontWeight="Bold"
                                       Foreground="DarkGreen"/>
                        </Border>


                        <TextBlock Text="Beschreibung"
                                   FontWeight="Bold"
                                   FontSize="16"/>

                        <TextBlock x:Name="BeschreibungTextBlock"
                                   Margin="0,5,0,15"
                                   TextWrapping="Wrap"/>


                        <TextBlock Text="Anleitung"
                                   FontWeight="Bold"
                                   FontSize="16"/>

                        <TextBlock x:Name="AnleitungTextBlock"
                                   Margin="0,5,0,15"
                                   TextWrapping="Wrap"/>


                        <TextBlock Text="Zutaten"
                                   FontWeight="Bold"
                                   FontSize="16"/>

                        <ListBox x:Name="ZutatenListBox"
                                 Margin="0,5,0,0"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </DockPanel>

</Window>